{
  "name": "aptmgr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:setup": "tsx --env-file-if-exists=.env.local scripts/db-setup.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "db:embed": "tsx --env-file-if-exists=.env.local scripts/embed.ts",
    "db:reset": "npm run db:setup && npm run db:seed",
    "test": "npm run test:db && npm run test:api",
    "test:db": "vitest run tests/db",
    "test:api": "vitest run tests/api"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/transformers": "^4.3.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
