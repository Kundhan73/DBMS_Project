# PostgreSQL 16 with the pgvector extension available
DATABASE_URL=postgres://aptmgr:change-me@localhost:5432/aptmgr
# Set to "require" for hosted databases that need TLS (Neon, Supabase, RDS ...)
PGSSL=

# 32+ random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# Embedding model (downloaded from Hugging Face on first use and cached)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# Optional: load the model from a local folder instead of downloading (offline machines)
TRANSFORMERS_LOCAL_MODEL_PATH=
TRANSFORMERS_CACHE_DIR=
